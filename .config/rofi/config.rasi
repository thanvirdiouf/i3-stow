* {
    bg: #282a36;
    fg: #f8f8f2;
    accent: #44475a;
    purple: #bd93f9;
    muted: #6272a4;
    /* Recolor the default theme's more specific row-state selectors, too. */
    background: @bg;
    foreground: @fg;
    lightbg: @accent;
    lightfg: @purple;
    blue: @purple;
    red: #ff5555;
    normal-background: @accent;
    selected-normal-foreground: @bg;
    separatorcolor: @muted;
    font: "JetBrainsMono Nerd Font 10";
    background-color: @bg;
    text-color: @fg;
}

window {
    padding: 3% 25% 3% 1.5%;
    border: 2px;
    border-color: @purple;
    border-radius: 30px;
    background-color: @bg; 
    width: 50%;
    height: 55%;
    background-image:            url("~/.config/rofi/sukubg.png", height);
}

mainbox {
    spacing: 15px;
    padding: 1%;
    border-color: @purple;
    background-color: @accent; 
    border-radius: 20px;
    border: 0px;
}

configuration {
    show-icons: true;
}
listview {
    background-color: @accent;
    spacing: 2px;
}

element {
    background-color: @accent;
    text-color: @fg;
    padding: 10px;
    border-radius: 10px;
    spacing: 10px;
}

element selected {
    background-color: @purple;
    text-color: @bg;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

inputbar {
    spacing:          15px;
    padding:          5px;
    background-color: @bg;
    border-radius:    20px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @purple;
    text-color:       @bg;
    padding:          10px 15px;
    border-radius:    15px;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder-color: @muted;
    placeholder:       "Search...";
    padding:           10px 0px;
    blink:             true;
}
